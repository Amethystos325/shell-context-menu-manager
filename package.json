{
  "name": "shell-context-menu-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "dev:renderer": "vite",
    "dev:electron": "concurrently -k \"npm:dev:electron:build-watch\" \"npm:dev:electron:run\"",
    "dev:electron:build-watch": "tsc -p tsconfig.electron.json --watch --preserveWatchOutput",
    "dev:electron:run": "wait-on tcp:5173 file:dist-electron/electron/main.js && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electronmon dist-electron/electron/main.js",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build": "tsc -b && npm run build:electron && vite build",
    "start": "electron dist-electron/electron/main.js",
    "typecheck": "tsc -b && tsc -p tsconfig.electron.json --noEmit",
    "core:smoke": "tsx scripts/core-smoke.ts",
    "editor:smoke": "tsx scripts/editor-smoke.ts",
    "preview:smoke": "tsx scripts/preview-smoke.ts",
    "release:smoke": "tsx scripts/release-smoke.ts",
    "res:parse-check": "tsx scripts/res-parse-check.ts",
    "stage6:diff": "tsx scripts/stage6-diff.ts",
    "stage6:matrix": "tsx scripts/stage6-matrix.ts",
    "stage6:visual-extract": "tsx scripts/stage6-visual-extract.ts",
    "stage6:visual-diff": "tsx scripts/stage6-visual-diff.ts",
    "stage6:autoplan": "tsx scripts/stage6-autoplan.ts",
    "stage6:regress": "tsx scripts/stage6-regress.ts",
    "stage6:real-capture": "tsx scripts/stage6-real-capture.ts",
    "stage6:real-regress": "tsx scripts/stage6-real-regress.ts",
    "stage5:hardening": "tsx scripts/stage5-hardening.ts",
    "package:win:dir": "npm run build && electron-builder --win dir --x64",
    "package:win": "npm run build && electron-builder --win nsis --x64",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "electronmon": "^2.0.4",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "com.shell.context.menu.manager",
    "productName": "Shell Context Menu Manager",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "win": {
      "signAndEditExecutable": false,
      "verifyUpdateCodeSignature": false,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  }
}
